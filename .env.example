# Example configuration for production
# Rename this file to .env and change the credentials to something secure before deploying.

POSTGRES_USER=your_secure_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=webmap
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Note: If deploying to a PaaS like Render, you can simply provide the full DATABASE_URL
# and the app will prioritize it over the individual credentials above.
# DATABASE_URL=postgresql://user:password@hostname:5432/webmap
